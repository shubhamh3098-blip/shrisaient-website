{
  "entities": {
    "Store": {
      "title": "Store",
      "description": "Shri Sai Enterprises ERP centralized store data document including customers, transactions, card members, and settings",
      "type": "object",
      "properties": {
        "customers": {
          "type": "array",
          "description": "Registered showroom and scheme customers"
        },
        "cardMembers": {
          "type": "array",
          "description": "30-month scheme card members"
        },
        "transactions": {
          "type": "array",
          "description": "Sales and payment transactions"
        },
        "cardTransactions": {
          "type": "array",
          "description": "Weekly and monthly card installment collections"
        },
        "billReceipts": {
          "type": "array",
          "description": "Bill receipts collected by counter or field agents"
        },
        "inventory": {
          "type": "array",
          "description": "Showroom stock and appliances"
        },
        "agents": {
          "type": "array",
          "description": "Field recovery and collection agents"
        },
        "lastUpdated": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      }
    }
  },
  "firestore": {
    "/stores/{storeId}": {
      "schema": "Store",
      "description": "Centralized real-time cloud data sync document for multi-device cross-platform synchronization"
    }
  }
}
