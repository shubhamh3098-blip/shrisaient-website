rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Shri Sai Enterprises - Store collection & all nested documents
    match /stores/{storeId}/{allPaths=**} {
      allow read, write: if true;
    }
    match /stores/{storeId} {
      allow read, write: if true;
    }
  }
}
